APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meteo10
DB_USER=meteo10
DB_PASSWORD=meteo10
DB_POOL_SIZE=5
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_MINUTES=480
PBKDF2_ITERATIONS=600000
FRONTEND_ORIGIN=http://localhost:3000
SENTRY_DSN=
SEED_ADMIN_EMAIL=admin@meteo10.local
SEED_ADMIN_PASSWORD=troque-esta-senha
OFFLINE_FACTOR=3

# Opcionais
# IPs de proxies confiáveis cujo X-Forwarded-For é aceito no rate limit do login (ex.: o servidor do Next)
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Executar tarefas periódicas (estações offline, limpeza de nonces) dentro do processo da API
BACKGROUND_TASKS=true
# Segredo fixo (32 hex) para o gateway de demonstração criado pelo seed; vazio = aleatório
SEED_GATEWAY_SECRET_HEX=
# Porta do MySQL publicada pelo docker compose
MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=meteo10-root
